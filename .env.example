# Real Cloud Run domain, set after the first deploy (see README "Deploy").
PUBLIC_DOMAIN=your-service-xxxxx.us-central1.run.app

# x402 (pay-per-call in USDC, Base mainnet -- cut over from Base Sepolia
# testnet, same pattern already applied to
# ws/live-entity-verification/erc8004-agent-liveness/onchain-activity-index/
# x402-receipt-verifier). RECEIVING wallet -- reuse the org treasury address
# (0x70e9f8057bb50e31b6ee06958bcbbe7de9daa98f), NOT the funded test wallet
# (X402_TEST_WALLET_ADDRESS in the repo root .env) -- that one pays, it
# doesn't receive. Using the payer wallet as its own payTo makes the
# facilitator reject every payment ("invalid_exact_evm_signature"
# self-payment bug, see skills/x402-payments). Renamed from
# X402_WALLET_ADDRESS -- fail-fast (os.environ[...], no placeholder default)
# now, same as the other cut-over assets.
NEXUS_X402_PAYTO_ADDRESS=0x70e9f8057bb50e31b6ee06958bcbbe7de9daa98f
X402_PRICE=$0.01

# CDP Facilitator credentials (replaces the x402.org facilitator as part of
# the same mainnet cutover) -- create_facilitator_config() reads these.
# Must be set in Cloud Run before this deploys, or the first real settle
# will 401.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Default false -- charges from day 1 (speculative low-tier candidate, no
# freemium window). Set true locally to test without a real facilitator round-trip.
NEXUS_X402_FREE_MODE=false

# How often the background full-catalog walk against 402index.io re-runs,
# in seconds. Default 600 (10 min). See main.py module docstring for why
# this exists instead of walking inline per request.
NEXUS_CATALOG_REFRESH_SECONDS=600

# 402index.io claim verification hash -- set after POST /api/v1/claim
# against the real deployed domain (see README "Distribution").
NEXUS_402INDEX_VERIFY_HASH=

# Telemetry (traffic_events / mcp_call_events / revenue_events) -- anon key only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
